# ==========================================
# Dependencies
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
!.env.*.example

# ==========================================
# Production & Build Outputs
# ==========================================
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# ==========================================
# Runtime Data & Logs
# ==========================================
**/logs/*
!**/logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploads: ignore dynamic uploads but preserve sample demo assets & structure
**/uploads/*
!**/uploads/.gitkeep
!**/uploads/guidelines.pdf
!**/uploads/lease_101.pdf
!**/uploads/sample_receipt_*.pdf

# ==========================================
# IDE & Code Editors
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/
*.sublime-workspace
*.sublime-project

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

