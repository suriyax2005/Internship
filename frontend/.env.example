# URL to your deployed Backend API (e.g. on Render, Railway, Fly.io)
# For local development with Vite proxy, leave empty or set to /api/v1
# For production separate hosting, set to: https://your-backend-api.onrender.com/api/v1
VITE_API_URL=https://your-backend-api.onrender.com/api/v1

# URL to your deployed Backend Socket.IO Server (e.g. https://your-backend-api.onrender.com)
VITE_SOCKET_URL=https://your-backend-api.onrender.com
