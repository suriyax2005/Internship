# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database URL (replace with your MongoDB Atlas cluster URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_rental_saas?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_rental_saas?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate strong random 64-character strings for production)
JWT_ACCESS_SECRET=your_super_strong_jwt_access_secret_production_2026
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_production_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Allowed Frontend Origins (Comma-separated for multiple origins, e.g. production Vercel URL and local testing)
# Example: https://smart-rental-saas.vercel.app,http://localhost:5173
CORS_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5173

# Cloudinary Storage (Required in production so uploaded files/photos persist across container restarts)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Configuration (Gmail App Password, SendGrid, Resend, or Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Smart Rental SaaS <noreply@smartrental.com>"
